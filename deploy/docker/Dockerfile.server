FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /src
COPY . .
RUN chmod +x gradlew && ./gradlew :server:installDist --no-daemon

FROM eclipse-temurin:21-jre-jammy
RUN useradd --system --uid 10001 --home /var/lib/opentermx opentermx
COPY --from=build /src/server/build/install/opentermx-server /opt/opentermx-server
RUN mkdir -p /var/lib/opentermx && chown -R opentermx:opentermx /var/lib/opentermx
USER 10001
EXPOSE 8765 8766
ENTRYPOINT ["/opt/opentermx-server/bin/opentermx-server"]
