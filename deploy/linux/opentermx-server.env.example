# Copiar a /etc/opentermx/server.env y restringirlo a root:opentermx (0640).
OPENTERMX_BIND=127.0.0.1
OPENTERMX_PORT=8765
OPENTERMX_DATA_DIR=/var/lib/opentermx
OPENTERMX_READ_ONLY=true

# Obligatorio si OPENTERMX_BIND no es loopback. No guardar el valor real en Git.
OPENTERMX_MCP_TOKEN=replace-with-a-long-random-token

# Gateway de agentes Windows. Si se omite el token, el gateway no se inicia.
OPENTERMX_AGENT_PORT=8766
# Recomendado: una credencial distinta por agente (`agentId=token`).
OPENTERMX_AGENT_CREDENTIALS_FILE=/etc/opentermx/secrets/agent_credentials.properties
# Compatibilidad de laboratorio (no usar junto con el archivo anterior):
# OPENTERMX_AGENT_TOKEN=replace-with-a-shared-long-random-token

# PostgreSQL del host Linux. En producción prefiera *_FILE y permisos 0600.
OPENTERMX_DB_HOST=127.0.0.1
OPENTERMX_DB_PORT=5432
OPENTERMX_DB_NAME=opentermx
OPENTERMX_DB_USER=opentermx
OPENTERMX_DB_PASSWORD_FILE=/etc/opentermx/secrets/db_password
OPENTERMX_DB_REQUIRED=true
